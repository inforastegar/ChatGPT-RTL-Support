{
  "version": "1.6.3",
  "manifest_version": 3,
  "name": "ChatGPT RTL Support (Farsi/Arabic)",
  "author": "reza rastegar",
  "description": "Dynamic Persian/Arabic RTL support for ChatGPT",
  "icons": {
    "16": "assets/img/logo.png", "32": "assets/img/logo.png",
    "48": "assets/img/logo.png", "128": "assets/img/logo.png"
  },
  "background": {"service_worker": "background.js"},
  "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
    "js": ["content.js"], "run_at": "document_idle"
  }],
  "permissions": ["storage", "scripting", "tabs", "fontSettings"],
  "action": {"default_title": "ChatGPT RTL Support", "default_popup": "popup.html"}
}
